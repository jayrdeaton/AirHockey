{
  "expo": {
    "name": "AirHockey",
    "slug": "AirHockey",
    "version": "1.0.0",
    "scheme": "airhockey",
    "description": "A digital AirHockey game",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/images/icon-dark.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.infinitetoken.AirHockey",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": {
        "dark": "./assets/images/icon-dark.png",
        "light": "./assets/images/icon-light.png"
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.infinitetoken.tastic"
        ]
      }
    },
    "android": {
      "package": "com.infinitetoken.airhockey"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon-dark.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-light.png",
          "imageWidth": 200,
          "backgroundColor": "#FAFAFA",
          "dark": {
            "image": "./assets/images/splash-dark.png",
            "backgroundColor": "#050505"
          }
        }
      ],
      "expo-asset",
      "@tastic/edge-guard",
      "@tastic/core",
      "./plugins/withSceneDelegate"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "00f202c0-d7a0-4422-afac-96501474d668"
      }
    },
    "owner": "jayrdeaton",
    "updates": {
      "url": "https://u.expo.dev/00f202c0-d7a0-4422-afac-96501474d668"
    }
  }
}
